# Development-only values. Replace every secret outside local development.
QUBERI_ENVIRONMENT=development
QUBERI_APP_VERSION=0.1.0
QUBERI_DEFAULT_LOCALE=en-US
QUBERI_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------------------------------------------------------------------------
# Google Sign-In. Optional — the app boots fine without it, the Google
# login/link buttons just report "not configured" until set. Create a
# Google Cloud "OAuth client ID" (Web application) with an authorized
# redirect URI of {QUBERI_PUBLIC_BASE_URL}/api/v1/auth/google/callback.
# ---------------------------------------------------------------------------
QUBERI_GOOGLE_CLIENT_ID=
QUBERI_GOOGLE_CLIENT_SECRET=

QUBERI_POSTGRES_USER=quberi
QUBERI_POSTGRES_PASSWORD=change-me-local-only
QUBERI_POSTGRES_DB=quberi
QUBERI_POSTGRES_PORT=5432
QUBERI_POSTGRES_DSN=postgresql://quberi:change-me-local-only@postgres:5432/quberi

QUBERI_REDIS_PORT=6379
QUBERI_REDIS_URL=redis://redis:6379/0

QUBERI_QDRANT_HTTP_PORT=6333
QUBERI_QDRANT_GRPC_PORT=6334
QUBERI_QDRANT_URL=http://qdrant:6333

QUBERI_MINIO_API_PORT=9000
QUBERI_MINIO_CONSOLE_PORT=9001
QUBERI_MINIO_ENDPOINT=minio:9000
QUBERI_MINIO_ACCESS_KEY=quberi-local
QUBERI_MINIO_SECRET_KEY=change-me-local-only
QUBERI_MINIO_BUCKET=quberi
QUBERI_MINIO_SECURE=false

QUBERI_API_PORT=8000
QUBERI_WEB_PORT=8080
VITE_API_BASE_URL=http://localhost:8000

# Platform bootstrap token. Leave EMPTY in shared environments — that disables
# every /api/v1/admin/* endpoint until real SSO ships. In local development
# set it to any string and pass it as ``Authorization: Bearer <token>``.
QUBERI_PLATFORM_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Email (SMTP) — bootstrap for the platform email sender (verification codes).
# Seeds the platform_email_settings DB row on first boot; admin API edits it
# afterwards. Use a transactional provider or a mailbox's SMTP authorization
# code (NOT the login password). Examples:
#   163:   host=smtp.163.com port=465 use_ssl=true  (password = 授权码)
#   gmail: host=smtp.gmail.com port=587 use_ssl=false (password = App Password)
# ---------------------------------------------------------------------------
QUBERI_SMTP_HOST=
QUBERI_SMTP_PORT=465
QUBERI_SMTP_USERNAME=
QUBERI_SMTP_PASSWORD=
QUBERI_SMTP_FROM=
QUBERI_SMTP_USE_SSL=true

# Optional secondary SMTP provider for failover (tried after the primary).
# e.g. an overseas Gmail fallback behind a domestic 163 primary.
QUBERI_SMTP2_HOST=
QUBERI_SMTP2_PORT=465
QUBERI_SMTP2_USERNAME=
QUBERI_SMTP2_PASSWORD=
QUBERI_SMTP2_FROM=
QUBERI_SMTP2_USE_SSL=true
