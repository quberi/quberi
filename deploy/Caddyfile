# Production reverse proxy for quberi.
# TLS is terminated here using a Cloudflare Origin CA certificate — see
# deploy/README.md for how to generate deploy/certs/cert.pem + key.pem.
# Cloudflare's SSL/TLS mode must be set to "Full (strict)" for this to work
# end-to-end encrypted between Cloudflare's edge and this server.

ai.quberi.com {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

	# OAuth authorization server metadata (RFC 8414) and the token/revoke
	# endpoints the tool itself calls — see api/v1/oauth.py's module
	# docstring for why every OAuth endpoint lives on this origin now
	# (previously issuer/token/revoke were on api.quberi.com while
	# authorization_endpoint, the consent page, was already here; several
	# MCP clients' OAuth implementations reject that split). Everything
	# else on this domain (the consent page itself, the web app, any
	# other /.well-known/* path) is still served by the web app.
	handle /.well-known/oauth-authorization-server {
		reverse_proxy api:8000
	}
	handle /api/v1/oauth/token {
		reverse_proxy api:8000
	}
	handle /api/v1/oauth/revoke {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:80
	}
}

api.quberi.com {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
	reverse_proxy api:8000
}

# MCP endpoint. A client that gets a 401 from the handler below reads the
# protected resource metadata (RFC 9728) served here, finds the
# authorization server, and reads that server's own metadata on
# ai.quberi.com (see the ai.quberi.com block above for why the
# authorization server moved there from api.quberi.com).
#
# `resource` must equal the audience of the tokens issued for this endpoint,
# character for character (no trailing slash), and `authorization_servers`
# must equal the `issuer` of the authorization server metadata.
mcp.quberi.com {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

	handle /.well-known/oauth-protected-resource {
		header Content-Type application/json
		respond `{"resource":"https://mcp.quberi.com","authorization_servers":["https://ai.quberi.com"],"scopes_supported":["knowledge:read","knowledge:write","knowledge:upload"],"bearer_methods_supported":["header"]}` 200
	}

	# The authorization server metadata lives on ai.quberi.com, not here.
	handle /.well-known/* {
		respond 404
	}

	# The MCP Streamable HTTP endpoint itself, mounted at the application
	# root inside the api container (api/v1/mcp/router.py). No path prefix:
	# `resource` above is the bare domain, so RFC 9728 requires this
	# endpoint's own URI to match it exactly.
	handle {
		reverse_proxy api:8000
	}
}

# Bare domain. Only used to prove domain ownership to the official MCP
# Registry (registry.modelcontextprotocol.io) via its HTTP verification
# method — the file's content is a public key, not a secret, and the
# registry's CLI (mcp-publisher) fetches it over plain HTTPS to match it
# against a signed challenge. Not used for anything else: there is no
# first-party product served at quberi.com itself.
quberi.com {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

	handle /.well-known/mcp-registry-auth {
		header Content-Type text/plain
		respond `v=MCPv1; k=ed25519; p=psV8Yyd01Xtt/xFm+d1p9h1b4IadcPfXMVvcS4eQBfw=` 200
	}

	handle {
		respond 404
	}
}

# Any other host that reaches this server gets a 404. Without this block Caddy
# answers an unconfigured host with an empty 200, which a client reads as
# success and then fails on the empty body.
:443 {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
	respond 404
}

# Caddy's automatic HTTPS feature redirects plain HTTP -> HTTPS for any site
# block with a real hostname, even when using manual TLS certs above — no
# extra config needed here.
