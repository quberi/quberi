# Production reverse proxy for quberi.
# TLS is terminated here using a Cloudflare Origin CA certificate — see
# deploy/README.md for how to generate deploy/certs/cert.pem + key.pem.
# Cloudflare's SSL/TLS mode must be set to "Full (strict)" for this to work
# end-to-end encrypted between Cloudflare's edge and this server.

ai.quberi.com {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
	reverse_proxy web:80
}

api.quberi.com {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
	reverse_proxy api:8000
}

# MCP endpoint. The discovery chain is served here before the MCP service
# exists: a client that gets a 401 reads the protected resource metadata
# (RFC 9728), finds the authorization server, and reads that server's own
# metadata on api.quberi.com.
#
# `resource` must equal the audience of the tokens issued for this endpoint,
# character for character (no trailing slash), and `authorization_servers`
# must equal the `issuer` of the authorization server metadata.
mcp.quberi.com {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

	handle /.well-known/oauth-protected-resource {
		header Content-Type application/json
		respond `{"resource":"https://mcp.quberi.com","authorization_servers":["https://api.quberi.com"],"scopes_supported":["knowledge:read","knowledge:write","knowledge:upload"],"bearer_methods_supported":["header"]}` 200
	}

	# The authorization server metadata lives on api.quberi.com, not here.
	handle /.well-known/* {
		respond 404
	}

	# Not implemented yet. 503 rather than 404: a 404 makes a client think
	# the address is wrong. Replace with `reverse_proxy <mcp service>` when
	# the service exists.
	handle {
		header Content-Type application/json
		respond `{"error":"mcp_not_ready"}` 503
	}
}

# Any other host that reaches this server gets a 404. Without this block Caddy
# answers an unconfigured host with an empty 200, which a client reads as
# success and then fails on the empty body.
:443 {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
	respond 404
}

# Caddy's automatic HTTPS feature redirects plain HTTP -> HTTPS for any site
# block with a real hostname, even when using manual TLS certs above — no
# extra config needed here.
